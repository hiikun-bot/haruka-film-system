# 環境変数（絶対にコミットしない）
.env
.env.local
.env.production
# .env.development / .env.production-readonly など .env.* の実ファイルもすべて除外（ひな形 *.example だけ管理する）
.env.*
!.env.example
!.env.*.example

# 依存パッケージ
node_modules

# SQLiteデータベース（旧セッションストアの残骸。本番セッションは Supabase http_sessions・ADR 040）
db/*.db
db/*.db-shm
db/*.db-wal
data/*.db
data/*.db-shm
data/*.db-wal

# アップロード一時ファイル
tmp/

# macOS
.DS_Store

# ログ
*.log
npm-debug.log*

# PR で merge 待ちの migration SQL を一時的に置く場所（Supabase に手動適用するため）
# README.md は git 管理する（運用ルール記載）
pending-migrations/*
!pending-migrations/README.md

# Claude Code のサブエージェント worktree（ローカル作業用、共有しない）
.claude/worktrees/

# 開発用DBスクリプトの出力（本番スキーマのダンプ・エラーログ。docs/dev-db-setup.md）
scripts/dev-db/.out/
