{
  "manifest_version": 3,
  "name": "Threads → ChatGPT 返信支援（API不要）",
  "version": "0.2.0",
  "description": "Threads画面を1クリック撮影し、ChatGPTの入力欄へ返信依頼を準備。OpenAI APIキー不要。",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "contextMenus",
    "offscreen",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ThreadsのスクショをChatGPTへ渡す"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "chatgpt-handoff.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
