# .env.production-readonly.example — 調査（請求突合など）で「本番を読む」ときだけ使う設定のひな形
# =============================================================
# 使い方（docs/dev-db-setup.md「本番を読む調査のとき」）:
#   1. このファイルを .env.production-readonly にコピーして本番の値を入れる（.gitignore 済み・絶対にコミットしない）
#   2. 調査スクリプトを次のように起動する。ここに書いた値が .env（開発用）より優先される:
#        node --env-file=.env.production-readonly scripts/delivery-ledger-check.js
#      （Node の --env-file で入れた値は、各スクリプトの require('dotenv').config() では上書きされない）
#   3. 終わったら普段どおり（--env-file なし）に戻す。.env 自体は開発用のまま触らない
#
# 注意:
#   - service_role キーは「読み取り専用」ではない。書き込みもできてしまうので、
#     このファイルで動かすのは「読むだけ」と分かっているスクリプトに限る（書き込む既存スクリプトは docs/dev-db-setup.md の一覧）
#   - サーバー（npm start / npm run dev）をこのファイルで起動しない。起動時の schema-sync・通知ワーカー・振込ポーリングが本番で動く
#   - 本当に読み取り専用にしたい場合は、本番に SELECT だけの Postgres ロールを作って PROD_DATABASE_URL に使う方法がある
#     （本番DBの権限変更になるので、やるときは別途相談）
# =============================================================

# 本番の Supabase（調査用）
SUPABASE_URL=https://<本番ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<本番の service_role キー>

# 本番を向いている自覚があるので、起動時の大きな警告を黙らせる
ALLOW_PROD_DB_FROM_LOCAL=1

# 手元から本番へ schema-sync を流さない（DATABASE_URL を空で上書き＋同期停止）
DATABASE_URL=
SCHEMA_AUTO_SYNC=false

# scripts/dev-db/dump-prod-schema.sh（本番の「表の形」だけを書き出す）が読む接続文字列。
# セッションプーラー（:5432）か直結を使う（トランザクションプーラー :6543 は pg_dump 不可）
PROD_DATABASE_URL=postgresql://postgres.<本番ref>:<本番DBパスワード>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
